{
  "name": "emails-by-andreea",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "sitemap": "node scripts/gen-sitemap.mjs",
    "prebuild": "node scripts/gen-share-card.mjs && node scripts/gen-sitemap.mjs",
    "build": "npm run build:client && npm run build:server && node scripts/prerender.mjs",
    "lint": "oxlint",
    "preview": "vite preview",
    "build:client": "vite build",
    "build:server": "vite build --ssr src/entry-server.jsx --outDir dist-ssr"
  },
  "dependencies": {
    "@portabletext/react": "^8.0.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.9.6"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "vite": "^8.1.1"
  }
}
